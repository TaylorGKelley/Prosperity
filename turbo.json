{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", ".expo/**"]
    },
    "db:migrate": {
      "cache": false,
      "persistent": false
    },
    "dev": { "cache": false, "persistent": true, "dependsOn": ["db:migrate"] },
    "lint": {}
  }
}
